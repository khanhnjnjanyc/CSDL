# ==============================================================================
# MEDCARE - CẤU HÌNH MÔI TRƯỜNG MẪU (.env.example)
# Sao chép file này thành .env và điền các tham số phù hợp với môi trường của bạn.
# ==============================================================================

# Môi trường chạy và bảo mật
APP_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-medcare-change-in-production

# Máy chủ Flask
HOST=127.0.0.1
PORT=5000

# Cấu hình Cơ sở dữ liệu: 'sqlite' hoặc 'mysql'
DB_TYPE=sqlite
SQLITE_PATH=medcare.db

# Cấu hình kết nối MySQL (dùng khi DB_TYPE=mysql, không hardcode mật khẩu trong code)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=phong_kham

# Cấu hình CORS
CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
